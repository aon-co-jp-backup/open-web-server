<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="16sp" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start server" />

    <Button
        android:id="@+id/shutdownButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shutdown_button" />

    <Button
        android:id="@+id/restartButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/restart_button" />

    <!--
      open-easy-webとSETで使う位置づけ(2026-07-24追記)——このアプリ自体は
      ドメイン設定/SFTP情報確認機能を持たないが、同一端末/同一LAN上で
      配信されているopen-easy-webウィザードへのワンタップ導線を用意する。
    -->
    <Button
        android:id="@+id/openEasyWebButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_easy_web_button" />

    <Button
        android:id="@+id/changeProfileButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/change_profile_button" />

    <!--
      DuckDNS DDNSドメイン設定画面への導線(2026-07-24新設)。
      Rust側`free_domain.rs`の管理API(POST /admin/ddns/setup-free-domain等)
      をこのAndroidアプリ内から使えるようにする。
    -->
    <Button
        android:id="@+id/ddnsSetupButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ddns_setup_button" />

    <!--
      ハードウェア検出結果の表示ボタン(2026-07-24(続き)新設)。
      `HardwareAccelDetector`が実際に検出したGPU/NPU/外部ディスプレイ
      情報をダイアログで表示する。
    -->
    <Button
        android:id="@+id/hardwareInfoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hardware_info_button" />

    <!--
      外付けHDD(root化端末専用)設定ボタン(2026-08-04新設)。
      `ExternalStorageConfig`参照。
    -->
    <Button
        android:id="@+id/externalStorageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/external_storage_button" />

    <!--
      MemoryInfoButton/DiskInfoButton(2026-08-06新設)。既存ボタン群と
      同じスタイル・配置感で追加する。
    -->
    <Button
        android:id="@+id/btnMemoryInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/memory_info_button" />

    <Button
        android:id="@+id/btnDiskInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/disk_info_button" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
