<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      2026-07-26: 排他選択(ボタン4個)→組み合わせ選択(チェックボックス3個
      +起動ボタン1個)へ変更(`ProfileSelectActivity`のdoc参照、「通常」は
      独立トグルではないためチェックボックスを持たない——全て未チェックの
      状態が「通常」を意味する)。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="640dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_select_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/profile_select_subtitle"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/checkMemorySaver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_memory_saver_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="36dp"
            android:text="@string/profile_memory_saver_desc"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkPowerSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_power_save_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="36dp"
            android:text="@string/profile_power_save_desc"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkAlwaysOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_always_on_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="36dp"
            android:text="@string/profile_always_on_desc"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/profile_normal_desc"
            android:textSize="12sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/buttonLaunchCombination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="@string/profile_launch_combination_button" />

    </LinearLayout>
</ScrollView>
